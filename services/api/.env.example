# StyleLens API local service configuration.
# Keep all model keys on the server; the extension only receives streamed results.

PORT=3001
STYLELENS_API_SECRET=stylelens-dev

# DeepSeek synthesis slot.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek dedicated vision slot.
# Both slots use the same DeepSeek API key and base URL.
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_VISION_TEMPERATURE=0.1
DEEPSEEK_VISION_IMAGE_DETAIL=auto
DEEPSEEK_VISION_MAX_IMAGES=4
