# StyleLens API —— 本地服务配置示例（复制为 .env 使用；启动时自动加载 services/api/.env）
# 硬约束：仅监听 127.0.0.1（用户确认），不对外提供服务。

# 服务端口
PORT=3001

# Extension 访问本地后端的共享密钥（MESSAGE_PROTOCOL §5.2；Extension 设置中需一致）
STYLELENS_API_SECRET=stylelens-dev

# AI Provider 优先级：DeepSeek -> OpenAI GPT -> mock
# 配置 DeepSeek 后优先使用 DeepSeek；没有 DeepSeek Key 时才使用 OpenAI Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI GPT（DeepSeek Key 未配置时的备用 provider）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
