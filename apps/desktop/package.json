{
  "name": "@stylelens/desktop",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "vite build",
    "build:api": "node scripts/build-api-sidecar.mjs",
    "stage:resources": "node scripts/stage-resources.mjs",
    "build:bundle": "pnpm --filter @stylelens/extension build && pnpm build:web && pnpm build:api && pnpm stage:resources",
    "build": "pnpm build:bundle",
    "tauri": "tauri",
    "tauri:dev": "pnpm build:bundle && tauri dev --no-watch",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@yao-pkg/pkg": "^6.22.0",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
