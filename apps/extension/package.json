{
  "name": "@stylelens/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-extension.mjs",
    "package": "node scripts/package-extension.mjs",
    "dev": "vite",
    "lint": "oxlint . && prettier --check .",
    "lint:fix": "oxlint --fix . && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.525.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.0",
    "zod": "^4.0.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/chrome": "^0.0.310",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "adm-zip": "^0.5.16",
    "oxlint": "^1.75.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.11",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
